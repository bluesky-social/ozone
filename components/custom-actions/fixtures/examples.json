{
  "version": 1,
  "customActions": [
    {
      "id": "label-and-close",
      "name": "Label as rude and close report",
      "helpText": "Apply rude to the current account or content and close the current report as actioned, linked to the label event.",
      "allowedRoles": [
        "tools.ozone.team.defs#roleModerator",
        "tools.ozone.team.defs#roleAdmin"
      ],
      "subjectTypes": ["account", "record"],
      "actions": [
        {
          "id": "label-subject",
          "type": "event",
          "target": "subject",
          "event": {
            "$type": "tools.ozone.moderation.defs#modEventLabel",
            "createLabelVals": ["rude"],
            "negateLabelVals": []
          },
          "reportAction": {
            "scope": "current"
          }
        }
      ]
    },
    {
      "id": "label-account-and-content",
      "name": "Label account and content, and close report",
      "helpText": "For records only: label the owning account kind, then label the content nice and close the current report as actioned, linked to the content label event.",
      "allowedRoles": [
        "tools.ozone.team.defs#roleModerator",
        "tools.ozone.team.defs#roleAdmin"
      ],
      "subjectTypes": ["record"],
      "actions": [
        {
          "id": "label-account",
          "type": "event",
          "target": "account",
          "event": {
            "$type": "tools.ozone.moderation.defs#modEventLabel",
            "createLabelVals": ["kind"],
            "negateLabelVals": []
          }
        },
        {
          "id": "label-content",
          "type": "event",
          "target": "subject",
          "event": {
            "$type": "tools.ozone.moderation.defs#modEventLabel",
            "createLabelVals": ["nice"],
            "negateLabelVals": []
          },
          "reportAction": {
            "scope": "current"
          }
        }
      ]
    },
    {
      "id": "note-and-escalate",
      "name": "Note & Escalate",
      "helpText": "Add an internal report note then escalate the current report.",
      "allowedRoles": [
        "tools.ozone.team.defs#roleModerator",
        "tools.ozone.team.defs#roleAdmin"
      ],
      "subjectTypes": ["account", "record"],
      "actions": [
        {
          "id": "add-report-note",
          "type": "activity",
          "target": "report",
          "activity": {
            "$type": "tools.ozone.report.defs#noteActivity"
          },
          "internalNote": "Not sure about this"
        },
        {
          "id": "escalate-report",
          "type": "activity",
          "target": "report",
          "activity": {
            "$type": "tools.ozone.report.defs#escalationActivity"
          }
        }
      ]
    },
    {
      "id": "optional-cleanup-and-note",
      "name": "Remove review tag and add note",
      "helpText": "Try removing review:example, then add an internal report note even if that cleanup fails. Review any failed step in history.",
      "allowedRoles": [
        "tools.ozone.team.defs#roleModerator",
        "tools.ozone.team.defs#roleAdmin"
      ],
      "subjectTypes": ["account", "record"],
      "actions": [
        {
          "id": "remove-review-tag",
          "type": "event",
          "target": "subject",
          "continueOnError": true,
          "event": {
            "$type": "tools.ozone.moderation.defs#modEventTag",
            "add": [],
            "remove": ["review:example"]
          }
        },
        {
          "id": "add-report-note",
          "type": "activity",
          "target": "report",
          "activity": {
            "$type": "tools.ozone.report.defs#noteActivity"
          },
          "internalNote": "Cleanup attempted; review its event history for the outcome."
        }
      ]
    },
    {
      "id": "scoped-account-review",
      "name": "Scoped account review",
      "helpText": "Add review:example to an account, only in queues 1 or 2 and only for the listed moderator. Replace the example queue IDs and moderator DID before use.",
      "allowedRoles": [
        "tools.ozone.team.defs#roleModerator",
        "tools.ozone.team.defs#roleAdmin"
      ],
      "allowedModeratorDids": ["did:plc:bbbbbbbbbbbbbbbbbbbbbbbb"],
      "queueIds": [1, 2],
      "subjectTypes": ["account"],
      "actions": [
        {
          "id": "tag-account",
          "type": "event",
          "target": "subject",
          "event": {
            "$type": "tools.ozone.moderation.defs#modEventTag",
            "add": ["review:example"],
            "remove": []
          }
        }
      ]
    }
  ]
}
